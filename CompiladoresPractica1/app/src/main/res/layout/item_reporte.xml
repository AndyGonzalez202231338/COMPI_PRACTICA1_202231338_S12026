<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/edittext_background"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/reporteTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REPORTE DE OPERADORES MATEMÁTICOS"
        android:textColor="#4ECDC4"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#333333"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Operador"
            android:textColor="#4ECDC4"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="Línea"
            android:textColor="#4ECDC4"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="Columna"
            android:textColor="#4ECDC4"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Contexto"
            android:textColor="#4ECDC4"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contenedorOperadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/reporteTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: 0 operadores"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:gravity="end" />

</LinearLayout>
